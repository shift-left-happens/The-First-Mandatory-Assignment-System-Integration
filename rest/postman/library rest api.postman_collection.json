        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Collection links\", function () {",
              "    pm.response.to.have.status(200);",
              "    const links = pm.response.json()._links;",
              "    pm.expect(links.books.href).to.include(\"/books\");",
              "    pm.expect(links.authors.href).to.include(\"/authors\");",
              "    pm.expect(links.publishers.href).to.include(\"/publishers\");",
              "});"
            ]
          }
        }
      ],
