# Optional configuration for local (non-Docker) runs.
#
# Copy this file to `.env` and run with:
#   node --env-file=.env src/index.js
#
# Inside Docker these values are provided by docker-compose.yml.

# Port the GraphQL server listens on.
PORT=4000

# Interface to bind (0.0.0.0 makes it reachable from other containers/hosts).
HOST=0.0.0.0

# Path to the SQLite database file.
# Default when unset: <repo-root>/database/library.db
# DB_PATH=../database/library.db
