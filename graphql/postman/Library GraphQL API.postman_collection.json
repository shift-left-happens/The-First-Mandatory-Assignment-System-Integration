    {
      "name": "Book Mutations",
      "item": [
        {
          "name": "Create Book",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation CreateBook($title: String!, $authorId: Int!, $publishingCompanyId: Int!, $publishingYear: Int!) {\n  createBook(title: $title, authorId: $authorId, publishingCompanyId: $publishingCompanyId, publishingYear: $publishingYear) {\n    id\n    title\n    authorId\n    publishingCompanyId\n    publishingYear\n  }\n}",
                "variables": "{\n  \"title\": \"New Book\",\n  \"authorId\": {{authorId}},\n  \"publishingCompanyId\": {{publisherId}},\n  \"publishingYear\": 2024\n}"
              }
            },
            "url": {
              "raw": "{{graphqlUrl}}",
              "host": [
                "{{graphqlUrl}}"
              ]
            },
            "description": "Create a book (saves the new id to {{bookId}})."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"No GraphQL errors\", () => pm.expect(json.errors, JSON.stringify(json.errors)).to.be.undefined);",
                  "const created = json.data && json.data.createBook;",
                  "if (created) { pm.environment.set(\"bookId\", created.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Book",
          "request": {
