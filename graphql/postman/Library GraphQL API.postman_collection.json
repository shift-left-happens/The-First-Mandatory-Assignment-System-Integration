    {
      "name": "Schema",
      "item": [
        {
          "name": "Schema Introspection",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query Introspection {\n  __schema {\n    queryType { name }\n    mutationType { name }\n    types {\n      kind\n      name\n      fields {\n        name\n        args { name }\n        type { kind name ofType { kind name ofType { kind name } } }\n      }\n    }\n  }\n}",
                "variables": ""
              }
            },
            "url": {
              "raw": "{{graphqlUrl}}",
              "host": [
                "{{graphqlUrl}}"
              ]
            },
            "description": "Introspection query: returns the full GraphQL schema (all types, fields and arguments)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"No GraphQL errors\", () => pm.expect(json.errors, JSON.stringify(json.errors)).to.be.undefined);",
                  "pm.test(\"Schema contains the Book type\", () => pm.expect(json.data.__schema.types.some(t => t.name === 'Book')).to.be.true);"
                ]
              }
            }
          ]
        }
      ]
    },
