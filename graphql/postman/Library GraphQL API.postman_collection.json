                "variables": "{\n  \"id\": {{bookId}},\n  \"title\": \"Updated Book\",\n  \"authorId\": {{authorId}},\n  \"publishingCompanyId\": {{publisherId}},\n  \"publishingYear\": 2025\n}"
              }
