        {
          "name": "List Publishers with Authors and Books",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query PublishersWithAuthorsAndBooks {\n  publishers {\n    id\n    name\n    authors {\n      id\n      name\n      surname\n      books {\n        id\n        title\n        publishingYear\n      }\n    }\n  }\n}",
                "variables": ""
              }
            },
            "url": {
              "raw": "{{graphqlUrl}}",
              "host": ["{{graphqlUrl}}"]
            },
            "description": "List all publishers and, in the same request, each publisher's authors and each author's books (Publisher -> Authors -> Books). Demonstrates GraphQL nesting."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"No GraphQL errors\", () => pm.expect(json.errors, JSON.stringify(json.errors)).to.be.undefined);",
                  "pm.test(\"Publishers nest authors which nest books\", () => {",
                  "  const author = json.data.publishers.flatMap(p => p.authors).find(a => a.books.length > 0);",
                  "  pm.expect(author, \"expected at least one author with books\").to.exist;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
